# LLM API Keys (Choose one or multiple)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Microsoft Azure (for Presidio Cloud)
AZURE_TEXT_ANALYTICS_KEY=your_azure_key_here
AZURE_TEXT_ANALYTICS_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/

# Google Cloud DLP (optional)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Server Configuration
PORT=3001
NODE_ENV=development

# Security Settings
ENABLE_DIFFERENTIAL_PRIVACY=true
PII_REDACTION_LEVEL=strict
INJECTION_DETECTION_MODE=block
PRIVACY_EPSILON=1.0

# Logging
LOG_LEVEL=info
ENABLE_SECURITY_LOGGING=true
